{
  "name": "projectxavier",
  "version": "0.1.0",
  "private": true,
  "description": "Expense tracker that lets the laziest user describe or scan expenses, with an avatar-driven assistant.",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:tz": "TZ=America/New_York jest recurring-local-day && TZ=Asia/Singapore jest recurring-local-day && TZ=America/New_York jest chat-day && TZ=Pacific/Auckland jest chat-day",
    "eval:intent": "tsx evals-lite/intent-report.mjs",
    "eval:query": "tsx evals-lite/query-report.mjs",
    "e2e": "maestro test e2e",
    "eval": "node evals/run-eval.mjs",
    "eval:cloud": "node evals/run-eval.mjs --engine=anthropic",
    "eval:openai": "node evals/run-eval.mjs --engine=openai",
    "eval:cloud:examples": "node evals/run-eval.mjs --engine=anthropic --examples",
    "eval:fm": "bash evals/fm/build.sh && FM_PROBE_PATH=$PWD/evals/fm/probe node evals/run-eval.mjs --engine=fm --n=2 --split=dev",
    "eval:fm:holdout": "bash evals/fm/build.sh && FM_PROBE_PATH=$PWD/evals/fm/probe node evals/run-eval.mjs --engine=fm --n=2 --split=holdout --confirm-holdout",
    "eval:fm:replay": "bash evals/fm/build.sh && FM_PROBE_PATH=$PWD/evals/fm/probe npx tsx evals/fm/replay-orders.mjs",
    "eval:questions": "tsx evals/test-questions.mjs && tsx evals/run-questions.mjs --engine=gate,floor",
    "eval:questions:cloud": "tsx evals/run-questions.mjs --engine=anthropic,openai",
    "eval:questions:fm": "bash evals/fm/build.sh && FM_PROBE_PATH=$PWD/evals/fm/probe tsx evals/run-questions.mjs --engine=fm",
    "eval:questions:cloud:closed": "tsx evals/run-questions.mjs --engine=anthropic,openai --cloud-arm=closed",
    "eval:questions:composite": "tsx evals/run-questions.mjs --engine=composite --composite-of=fm && tsx evals/run-questions.mjs --engine=composite --composite-of=anthropic,openai --cloud-arm=closed",
    "eval:questions:fm:known": "bash evals/fm/build.sh && FM_PROBE_PATH=$PWD/evals/fm/probe tsx evals/run-questions.mjs --engine=fm --fm-arm=known-categories",
    "eval:fm:screen": "bash evals/fm/build.sh && FM_PROBE_PATH=$PWD/evals/fm/probe npx tsx evals/fm/screen-throws.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/portal": "^1.0.14",
    "@react-native-ai/apple": "0.12.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@ungap/structured-clone": "^1.3.2",
    "ai": "^6.0.219",
    "drizzle-orm": "^0.36.4",
    "expo": "^58",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "nativewind": "4.1.23",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-cloud-storage": "^3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "web-streams-polyfill": "^4.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.97",
    "@ai-sdk/openai": "^3.0.85",
    "@bacons/apple-targets": "^5.0.0",
    "@expo/config-plugins": "^58.0.10",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/ungap__structured-clone": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^8.57.1",
    "jest": "~30.5.2",
    "jest-cucumber": "^4.5.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
